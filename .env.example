# NeoV6 ML engine — environment variables.
# Copy to .env and fill in. Do NOT commit the real .env (it is gitignored).

# =========================================================================
# Database (MongoDB Atlas). If unset, the engine falls back to an in-memory
# mock — fine for local dev, NOT for anything you want to persist.
# =========================================================================
MONGO_URI=

# =========================================================================
# CORS — comma-separated browser origins allowed to call the engine directly.
# =========================================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =========================================================================
# Node backend link. The engine pushes bot logs / status / trade-alerts to
# the backend's /api/internal/broadcast, which relays them to the browser.
# INTERNAL_API_KEY is the shared secret and MUST match the backend's value.
# =========================================================================
NODE_BACKEND_URL=http://localhost:10000
INTERNAL_API_KEY=

# =========================================================================
# Fleet control auth (optional, recommended for production).
# When set, the engine requires the X-Internal-Key header on
# POST /api/fleet/start and /stop, so only the Node backend (which forwards
# ENGINE_API_KEY as X-Internal-Key) can start/stop fleets. Keyless direct
# calls to :8000 get 401. Leave EMPTY to keep those endpoints open.
# Set the SAME value here and as ENGINE_API_KEY on the Node backend.
# =========================================================================
ENGINE_API_KEY=

# =========================================================================
# Cross-restart persistence — relaunch bots that were running when the engine
# last stopped (from bot_state.db). Default: true.
# =========================================================================
AUTO_RESUME_BOTS=true

# =========================================================================
# Macro regime router — how often (seconds) to refresh the BTC risk-on/off
# read that tilts the fleet. Default: 600 (10 min).
# =========================================================================
MACRO_REGIME_REFRESH_SEC=600

# =========================================================================
# Monthly exit-edge re-validation audit — re-runs exit_lab's cross-coin
# walk-forward when exit_lab_results.json is older than the interval, off the
# event loop. This is a STRUCTURAL audit, not the real-time responder.
# =========================================================================
EXIT_AUDIT_ENABLED=true
EXIT_AUDIT_INTERVAL_DAYS=30

# =========================================================================
# Self-learning loop (optional). Periodically retrains models in the
# background. Default ENABLED=true; set false to disable. Heavy; disable on
# small boxes.
# =========================================================================
SELF_LEARN_ENABLED=true
SELF_LEARN_INTERVAL_HOURS=6
SELF_LEARN_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
SELF_LEARN_TIMEFRAME=1h
SELF_LEARN_DEEP_EVERY=4

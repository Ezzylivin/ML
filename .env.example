# NeoV6 ML service — environment variables
# Copy to .env and fill in. Do NOT commit the real .env.

# --- Database (optional; falls back to in-memory mock if unset) ---
MONGO_URI=

# --- CORS: comma-separated list of allowed browser origins ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Node backend link (for pushing bot logs/status to the UI) ---
NODE_BACKEND_URL=http://localhost:10000
INTERNAL_API_KEY=               # shared secret for the backend's /api/internal/broadcast (must match the backend)

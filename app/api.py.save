import threading
import traceback
import logging
import os
import json
import re

from fastapi import FastAPI, Request, BackgroundTasks, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from fastapi.encoders import jsonable_encoder
from pydantic import BaseModel, Field, ValidationError

from .config import bots_collection, RESULTS_DIR
from .live_bot import LiveExecutiveBot
from .utils import recursive_clean, normalize_positions, generate_chart_markers

# Initialize FastAPI
app = FastAPI(title="Sovereign Executive v89.42")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_credentials=True, allow_methods=["*"], allow_headers=["*"])

# Global Variables
active_live_bots = {}
bots_lock = threading.Lock()
logger = logging.getLogger("System")
if logger.hasHandlers():
    logger.handlers.clear()
handler = logging.StreamHandler()
logger.addHandler(handler)
logger.setLevel(logging.INFO)


@app.on_event("startup")
async def startup_event():
    logger.info("Server Started.")


# Health Check Route
@app.get("/")
def health_check():
    return {"status": "online", "version": "89.42"}


# Input validation models
class StartBotRequest(BaseModel):
    userId: str
    symbol: str = Field(default="BTC-USD", pattern=r"^[A-Z]{2,5}-[A-Z]{2,5}$", description="Trading symbol")
    strategies: list = Field(default=[], description="List of strategies for the bot")
    initialBalance: float = Field(default=1000.0, description="Initial trading balance")


class StopBotRequest(BaseModel):
    userId: str = Field(..., description="Unique user ID for stopping the bot")


@app.post('/api/bot/start')
async def start_bot(request: StartBotRequest, bg: BackgroundTasks):
    """Start a bot with specific configurations."""
    try:
        bot_id = f"{request.userId}_{request.symbol.replace('/', '-')}"
        body = recursive_clean(request.dict())
        body["botId"] = bot_id

        # Use lock for thread-safety
        with bots_lock:
            if bot_id in active_live_bots:
                return JSONResponse(content=jsonable_encoder({"status": "already_running", "botId": bot_id}))

            bot = LiveExecutiveBot(body)
            active_live_bots[bot_id] = bot
            bg.add_task(bot.sync_and_trade)
            logger.info(f"Bot started with botId: {bot_id}")

        return {"status": "started", "botId": bot_id}
    except ValidationError as ve:
        logger.error(f"Validation error: {ve}")
        return JSONResponse(content={"error": "Invalid parameters"}, status_code=422)
    except Exception as e:
        logger.error(f"Failed to start bot: {traceback.format_exc()}")
        return JSONResponse(content={"error": str(e)}, status_code=500)


@app.post('/api/bot/stop')
async def stop_bot(request: StopBotRequest):
    """Stop a bot for a specific user ID."""
    try:
        target_id = request.userId
        count = 0

        # Thread-safe bot management
        with bots_lock:
            to_remove = []
            for bid, bot in list(active_live_bots.items()):
                if target_id in bid:
                    bot.stop()
                    to_remove.append(bid)
                    count += 1
            for bid in to_remove:
                del active_live_bots[bid]

        if count > 0:
            logger.info(f"Successfully stopped {count} bot(s) for userId: {target_id}")
            return {"status": "stopped", "count": count}
        return {"status": "no_bots_found", "userId": target_id}
    except Exception as e:
        logger.error(f"Failed to stop bot: {traceback.format_exc()}")
        return JSONResponse({"status": "error", "message": "Failed to stop bot"}, status_code=500)





















































































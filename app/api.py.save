@app.get('/api/bot/logs')
async def get_bot_logs(botId: str = None, userId: str = None, limit: int = 200):
    """Retrieve bot logs with an optional limit."""
    try:
        lookup_id = botId or userId
        if not lookup_id:
            raise HTTPException(status_code=400, detail="Either botId or userId is required.")

        doc = bots_collection.find_one({"botId": {"$regex": f"^{lookup_id}"}})
        if doc and "logs" in doc:
            sorted_logs = sorted(doc["logs"], key=lambda x: x["timestamp"], reverse=True)
            return sorted_logs[:limit]

        return JSONResponse(content=[], status_code=404)

    except Exception as e:
        logger.error(f"Failed to fetch bot logs: {traceback.format_exc()}")
        return JSONResponse(content={"error": "Failed to fetch logs"}, status_code=500)


@app.get("/api/bot/winners")
def get_winners():
    """Retrieve strategy winner configurations."""
    try:
        if not os.path.exists(RESULTS_DIR):
            return JSONResponse(content=[], status_code=200)

        winners = []
        for file_name in os.listdir(RESULTS_DIR):
            if file_name.endswith(".json"):
                file_path = os.path.join(RESULTS_DIR, file_name)
                try:
                    with open(file_path, "r") as f:
                        data = json.load(f)
                        winners.append({
                            "id": file_name.replace(".json", ""),
                            "name": file_name.replace(".json", ""),
                            "config": data
                        })
                except json.JSONDecodeError as e:
                    logger.warning(f"Failed to parse JSON file {file_name}: {e}")
                    continue

        winners.sort(key=lambda x: x['config'].get('metrics', {}).get('totalReturn', 0), reverse=True)
        return winners

    except Exception as e:
        logger.error(f"Failed to fetch winners: {traceback.format_exc()}")
        return JSONResponse(content={"error": "Failed to fetch winners"}, status_code=500)


@app.post('/api/backtest/combo')
@app.post('/api/backtest/run')
@app.post('/api/ml/run-combo-backtest')
async def handle_backtest(request: Request):
    """Run backtesting and return results."""
    try:
        body = await request.json()
        symbol = body.get('symbol', 'BTC-USD').replace('-', '/')
        timeframe = body.get('timeframe', '1h')

        if not symbol or not timeframe:
            raise HTTPException(status_code=400, detail="Missing 'symbol' or 'timeframe'.")

        # Import libraries dynamically to reduce runtime memory usage
        import ccxt
        import pandas as pd
        from .manager import PrecisionPyramidManager
        from .strategies import compute_signal

        # Fetch market data to a DataFrame
        exchange = ccxt.coinbase()
        ohlcv = exchange.fetch_ohlcv(symbol, timeframe, limit=1000)
        df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
        df.set_index(pd.to_datetime(df['timestamp'], unit='ms', utc=True), inplace=True)

        # Apply indicators
        df.ta.sma(length=10, append=True)
        df.ta.sma(length=50, append=True)
        df.ta.macd(append=True)
        df.ta.rsi(length=14, append=True)

        # Initialize bot models
        risk_pct = float(body.get('riskPercentage', 1)) / 100
        mgr = PrecisionPyramidManager(
            capital=body.get('initialBalance', 1000),
            risk_mode=body.get('riskManagementMode', 'static'),
            base_risk=risk_pct
        )

        # Backtest loop
        curve = []
        for i in range(50, len(df)):  # Skip the 1st 50 periods
            close_price = df['close'].iloc[i]
            mgr.handle(1, close_price, *df.iloc[i], close_price)
            curve.append({'timestamp': df.index[i].isoformat(), 'balance': mgr.step_equity(close_price)})

        res = {
            "metrics": {
                "totalReturn": round((curve[-1]['balance'] - body.get('initialBalance', 1000)) / 1000 * 100, 2)
            },
            "equityCurve": curve
        }
        return JSONResponse(content=jsonable_encoder(res))

    except Exception as e:
        logger.error(f"Backtest failed: {traceback.format_exc()}")
        return JSONResponse(content={"error": str(e)}, status_code=500)


@app.get("/api/ml/available-models")
def list_models():
    """List all available ML models in the MODEL_DIR."""
    try:
        from .config import MODEL_DIR
        if not os.path.exists(MODEL_DIR):
            return []

        return [{"id": f.split('.')[0], "name": f.split('.')[0]} for f in os.listdir(MODEL_DIR) if f.endswith('.joblib')]

    except Exception as e:
        logger.error(f"Error fetching ML models: {traceback.format_exc()}")
        return JSONResponse({"error": str(e)}, status_code=500)

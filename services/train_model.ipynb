# --- Standard Library Imports ---
import os
import sys

# --- Third-Party Imports ---
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import joblib
from sklearn.metrics import classification_report
from imblearn.over_sampling import SMOTE
from xgboost import XGBClassifier
from sklearn.model_selection import RandomizedSearchCV

# --- Local Application Imports ---
# Assumes your .py files are in the same folder as this notebook.
# IMPORTANT: Make sure 'feature_engineering' matches your actual .py filename.
from feature_engineering import engineer_features 
from backtest_service import run_backtest

print("✅ Libraries and local modules imported successfully.")




# --- Configure and Load RAW OHLCV Data ---
# Change this line to 'BTC-USD-1h.csv' or 'ETH-USD-1h.csv' depending on the model you want to train.
RAW_DATA_FILE = 'data/ETH-USD-1h.csv'

if not os.path.exists(RAW_DATA_FILE):
    raise FileNotFoundError(f"{RAW_DATA_FILE} does not exist! Run download_data.py first.")

df_raw = pd.read_csv(RAW_DATA_FILE, parse_dates=True)
print(f"Raw data loaded. Shape: {df_raw.shape}")

# --- Engineer Features On-the-Fly ---
df_processed = engineer_features(df_raw.copy())
print(f"Features engineered successfully. Shape: {df_processed.shape}")
df_processed.head()




# --- Define Base Features ---
base_features = [col for col in df_processed.columns if '_signal' in col or 'strength' in col]

# --- Create Lag Features ---
for lag in [1, 2, 3]:
    df_processed[f'target_lag{lag}'] = df_processed['target'].shift(lag)

# Handle NaNs created by shifting
df_processed.fillna(0, inplace=True)
lag_features = [f'target_lag{lag}' for lag in [1, 2, 3]]

# --- Combine into Final Feature Matrix (X) and Target (y) ---
final_features = base_features + lag_features
X = df_processed[final_features]
y = df_processed['target']

print(f"✅ Final feature matrix X shape: {X.shape}")
print(f"✅ Final features include: {final_features}")




# --- Split Data (Time-Series Safe) ---
split_point = int(len(df_processed) * 0.8)
X_train, X_test = X.iloc[:split_point], X.iloc[split_point:]
y_train, y_test = y.iloc[:split_point], y.iloc[split_point:]

print(f"Training samples: {len(X_train)}, Testing samples: {len(X_test)}")

# --- Encode Labels for XGBoost { -1, 0, 1 } -> { 0, 1, 2 } ---
y_train_xgb = y_train + 1
y_test_xgb = y_test + 1

# --- Balance Training Data with SMOTE ---
smote = SMOTE(random_state=42)
X_train_bal, y_train_bal = smote.fit_resample(X_train, y_train_xgb)

print(f"\nOriginal training labels: {np.bincount(y_train_xgb.astype(int))}")
print(f"Balanced training labels with SMOTE: {np.bincount(y_train_bal.astype(int))}")




# Initialize the XGBoost Classifier
xgb = XGBClassifier(
    random_state=42,
    n_jobs=-1,
    objective='multi:softprob',
    eval_metric='mlogloss',
    use_label_encoder=False 
)

# Define the search space
param_grid = {
    'n_estimators': [100, 200, 300, 400, 500],
    'max_depth': [3, 5, 7, 9],
    'learning_rate': [0.01, 0.05, 0.1, 0.2],
    'subsample': [0.7, 0.8, 0.9, 1.0],
    'colsample_bytree': [0.7, 0.8, 0.9, 1.0]
}

random_search = RandomizedSearchCV(
    estimator=xgb,
    param_distributions=param_grid,
    n_iter=25, # Number of parameter settings that are sampled
    scoring='f1_macro',
    cv=3,
    verbose=4,
    random_state=42,
    n_jobs=-1
)

print("🚀 Starting hyperparameter tuning...")
random_search.fit(X_train_bal, y_train_bal)

print("✅ Hyperparameter tuning complete!")
print("Best Parameters:", random_search.best_params_)




# Get the best model from the search
model = random_search.best_estimator_

# Get predictions on the test set
predictions_mapped = model.predict(X_test)
predictions = predictions_mapped - 1 # Convert back to {-1, 0, 1}

print("\n📊 Classification Report (All Predictions):")
print(classification_report(y_test, predictions, digits=3))

# --- Evaluate with Confidence Filtering ---
probabilities = model.predict_proba(X_test)

results_df = pd.DataFrame(index=y_test.index)
results_df['true_label'] = y_test
results_df['prediction'] = predictions

# Robustly map probabilities to the correct columns
class_map = {model.classes_[i]: i for i in range(len(model.classes_))}
results_df['confidence_sell'] = probabilities[:, class_map[0]] # Prob of class 0 (-1)
results_df['confidence_hold'] = probabilities[:, class_map[1]] # Prob of class 1 (0)
results_df['confidence_buy']  = probabilities[:, class_map[2]] # Prob of class 2 (1)
results_df['confidence_of_prediction'] = probabilities.max(axis=1)

# Apply confidence threshold
CONFIDENCE_THRESHOLD = 0.65
results_df['high_conf_prediction'] = np.where(
    results_df['confidence_of_prediction'] > CONFIDENCE_THRESHOLD,
    results_df['prediction'],
    0 # Default to 'Hold' if not confident
)

print(f"\n📊 Classification Report (Confidence > {CONFIDENCE_THRESHOLD*100}%):")
print(classification_report(results_df['true_label'], results_df['high_conf_prediction']))



output_model_folder = 'models'
os.makedirs(output_model_folder, exist_ok=True)

# Choose which model file to save
# output_model_file = os.path.join(output_model_folder, 'btc_xgboost_model.joblib')
output_model_file = os.path.join(output_model_folder, 'eth_xgboost_model.joblib')

joblib.dump(model, output_model_file)
print(f"\n✅ Final tuned model saved successfully to: {output_model_file}")



# --- Run the final backtest using your service ---
df_backtest = df_processed.iloc[split_point:].copy()

# Use the high-confidence predictions for the backtest for better performance
df_backtest['predicted_target'] = results_df['high_conf_prediction'] 

backtest_results = run_backtest(df_backtest)

print("\n--- Backtest Results (High Confidence Strategy) ---")
print(f"Final Balance: ${backtest_results['final_balance']:.2f}")
print(f"Total Profit: {backtest_results['total_profit_pct']:.2f}%")
print(f"Max Drawdown: {backtest_results['max_drawdown_pct']:.2f}%")
print(f"Win Rate: {backtest_results['win_rate']:.2f}%")
print(f"Profit Factor: {backtest_results['profit_factor']:.2f}")
print(f"Total Trades: {backtest_results['total_trades']}")
